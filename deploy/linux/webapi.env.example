ASPNETCORE_ENVIRONMENT=Production
Kestrel__Endpoints__Http__Url=http://0.0.0.0:6379
Kestrel__Endpoints__Grpc__Url=http://127.0.0.1:7000
CollectorControl__Enabled=true
CollectorControl__GatewayApiKey=replace-with-private-random-key
Market__MySqlConnection=Server=127.0.0.1;Port=3306;Database=astock_monitor;User ID=astock_webapi;Password=replace-me;SslMode=Required;AllowPublicKeyRetrieval=True;
Market__DurableIngestEnabled=false
Market__PersistenceEnabled=false
LegacyRedisWorkers__Enabled=false
Swagger__Enabled=false
DOTNET_GCConserveMemory=9
Operations__PublicWebsiteUrl=http://web-node.example.invalid:6379
